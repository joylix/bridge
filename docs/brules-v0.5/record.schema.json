{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridge.local/schema/bridge-record-table-board-1.1.json",
  "title": "Bridge TableBoard record (Profile S)",
  "description": "单桌对局记录（Schema 1.1）。Profile S 的 Deal 与一个 TableBoard；Profile P 的 SessionBoard 聚合不在此 Schema 中。1.1 增加 INCOMPLETE / REOPENED、取消/调整历史、可空原始分、叫牌结束后的 IN_PROGRESS 定约，以及 WBF 2017 计分版本标记。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "profile",
    "recordType",
    "recordId",
    "createdAt",
    "deal",
    "status",
    "auction",
    "score",
    "hcp",
    "engine"
  ],
  "properties": {
    "format": { "const": "bridge-record" },
    "schemaVersion": { "const": "1.1" },
    "profile": { "const": "standalone" },
    "recordType": { "const": "table-board" },
    "recordId": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "producer": { "$ref": "#/$defs/Producer" },
    "deal": { "$ref": "#/$defs/Deal" },
    "status": { "$ref": "#/$defs/Status" },
    "auction": { "$ref": "#/$defs/Auction" },
    "contract": { "$ref": "#/$defs/Contract" },
    "declarer": { "$ref": "#/$defs/Seat" },
    "tricksTaken": { "type": "integer", "minimum": 0, "maximum": 13 },
    "play": { "$ref": "#/$defs/Play" },
    "score": { "$ref": "#/$defs/Score" },
    "hcp": { "$ref": "#/$defs/Hcp" },
    "derived": { "$ref": "#/$defs/Derived" },
    "adjustment": { "$ref": "#/$defs/Adjustment" },
    "adjustHistory": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Adjustment" }
    },
    "engine": { "$ref": "#/$defs/Engine" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "enum": ["PASSED_OUT", "CANCELLED", "REOPENED", "INCOMPLETE"] } },
        "required": ["status"]
      },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["contract"] },
            { "required": ["declarer"] },
            { "required": ["tricksTaken"] },
            { "required": ["play"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "PLAYED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["contract", "declarer", "tricksTaken", "play"]
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "PASSED_OUT" } },
        "required": ["status"]
      },
      "then": {
        "properties": { "score": { "properties": { "nsRaw": { "const": 0 } } } }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["CANCELLED", "INCOMPLETE", "REOPENED"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "score": { "properties": { "nsRaw": { "type": "null" } } },
          "derived": {
            "properties": {
              "imp": { "properties": { "singleTable": { "type": "null" } } }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "ADJUSTED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["adjustment", "adjustHistory"],
        "properties": {
          "score": { "properties": { "nsRaw": { "type": "integer" } } }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "CANCELLED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["adjustment"],
        "properties": {
          "adjustment": { "properties": { "kind": { "const": "CANCEL" } } }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "const": "REOPENED" } },
        "required": ["status"]
      },
      "then": {
        "required": ["adjustment"],
        "properties": {
          "adjustment": { "properties": { "kind": { "const": "REOPEN" } } }
        }
      }
    }
  ],
  "$defs": {
    "Seat": { "type": "string", "enum": ["N", "E", "S", "W"] },
    "Vulnerability": { "type": "string", "enum": ["NONE", "NS", "EW", "ALL"] },
    "Status": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "PLAYED",
        "PASSED_OUT",
        "CANCELLED",
        "ADJUSTED",
        "INCOMPLETE",
        "REOPENED"
      ],
      "description": "桌副状态。INCOMPLETE=缺桌/超时未完成；REOPENED=裁判重开、等待重新开始。"
    },
    "Call": {
      "type": "string",
      "enum": [
        "PASS", "X", "XX",
        "1C", "1D", "1H", "1S", "1NT",
        "2C", "2D", "2H", "2S", "2NT",
        "3C", "3D", "3H", "3S", "3NT",
        "4C", "4D", "4H", "4S", "4NT",
        "5C", "5D", "5H", "5S", "5NT",
        "6C", "6D", "6H", "6S", "6NT",
        "7C", "7D", "7H", "7S", "7NT"
      ]
    },
    "Producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["application"],
      "properties": {
        "application": { "type": "string", "minLength": 1 },
        "version": { "type": "string" }
      }
    },
    "Deal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dealId", "boardNumber", "dealer", "vulnerability", "pbn"],
      "properties": {
        "dealId": { "type": "string", "minLength": 1 },
        "boardNumber": { "type": "integer", "minimum": 1 },
        "dealer": { "$ref": "#/$defs/Seat" },
        "vulnerability": { "$ref": "#/$defs/Vulnerability" },
        "pbn": {
          "type": "string",
          "minLength": 1,
          "description": "PBN [Deal] 值，不含方括号；初始发牌必须四手、每手 13 张、52 张互不重复。"
        }
      }
    },
    "Auction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "completed"],
      "properties": {
        "calls": {
          "type": "array",
          "items": { "$ref": "#/$defs/Call" }
        },
        "completed": { "type": "boolean" }
      }
    },
    "Contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "denomination", "doubled"],
      "properties": {
        "level": { "type": "integer", "minimum": 1, "maximum": 7 },
        "denomination": { "type": "string", "enum": ["C", "D", "H", "S", "NT"] },
        "doubled": { "type": "string", "enum": ["NONE", "X", "XX"] }
      },
      "description": "叫牌结束且定约已确立时出现，不论最终做成还是宕掉；IN_PROGRESS 在叫牌结束后也允许携带。"
    },
    "CardPlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seat", "card"],
      "properties": {
        "seat": { "$ref": "#/$defs/Seat" },
        "card": {
          "type": "string",
          "pattern": "^[2-9TJQKA][CDHS]$",
          "description": "规范牌张：点数 + 花色，例如 AS、TD、2C。"
        }
      }
    },
    "Trick": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leader", "cards", "winner"],
      "properties": {
        "leader": { "$ref": "#/$defs/Seat" },
        "cards": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/$defs/CardPlay" }
        },
        "winner": { "$ref": "#/$defs/Seat" }
      }
    },
    "Play": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tricks"],
      "properties": {
        "tricks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 13,
          "items": { "$ref": "#/$defs/Trick" }
        }
      }
    },
    "Score": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nsRaw", "source"],
      "properties": {
        "nsRaw": {
          "type": ["integer", "null"],
          "description": "NS 视角带符号原始分：NS 得分减 EW 得分。流局为 0；CANCELLED / INCOMPLETE / REOPENED 必须为 null（不得写 0）。"
        },
        "source": { "type": "string", "enum": ["computed", "director"] }
      }
    },
    "Hcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ns", "ew"],
      "properties": {
        "ns": { "type": "integer", "minimum": 0, "maximum": 40 },
        "ew": { "type": "integer", "minimum": 0, "maximum": 40 }
      },
      "description": "ns + ew 必须等于 40；用于贴点重算。"
    },
    "Derived": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imp": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "singleTable": { "type": ["integer", "null"] },
            "tableVersion": { "type": "string", "const": "wbf-2017" }
          }
        },
        "adjusted": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profile", "nsPoints"],
          "properties": {
            "profile": { "type": "string", "minLength": 1 },
            "nsPoints": { "type": "integer" }
          },
          "description": "Schema 1.0 兼容字段；1.1 新记录以 adjustment / adjustHistory 为准。"
        },
        "mp": { "type": "number" }
      }
    },
    "Adjustment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reason",
        "actor",
        "at",
        "beforeStatus",
        "afterStatus",
        "beforeValue",
        "afterValue"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["ADJUST", "CANCEL", "REOPEN"],
          "description": "ADJUST=裁判改分；CANCEL=取消该副；REOPEN=重开审计。"
        },
        "reason": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "format": "date-time" },
        "beforeStatus": { "$ref": "#/$defs/Status" },
        "afterStatus": { "$ref": "#/$defs/Status" },
        "originalRawScore": {
          "type": ["integer", "null"],
          "description": "首次调整前的原始分；取消/重开为 null。"
        },
        "beforeValue": {
          "type": ["integer", "null"],
          "description": "本次操作前的原始分；无成绩时为 null。"
        },
        "afterValue": {
          "type": ["integer", "null"],
          "description": "本次操作后的原始分；CANCEL / REOPEN 必须为 null。"
        },
        "artificialAverage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nsRaw", "artificial"],
          "properties": {
            "nsRaw": { "type": "integer" },
            "artificial": { "const": true }
          },
          "description": "取消副的赛制补偿分，单独保存；不得写进 score.nsRaw。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "ADJUST" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["afterValue"],
            "properties": { "afterValue": { "type": "integer" } }
          }
        },
        {
          "if": {
            "properties": { "kind": { "enum": ["CANCEL", "REOPEN"] } },
            "required": ["kind"]
          },
          "then": {
            "properties": { "afterValue": { "type": "null" } }
          }
        }
      ]
    },
    "RuleSetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rulesetId", "overlay"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "rulesetId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "overlay": { "type": "boolean" }
      }
    },
    "SignalSettings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "signal_spot_max_rank": { "type": "integer", "minimum": 2, "maximum": 14 },
        "encourage_discard_min_rank": { "type": "integer", "minimum": 2, "maximum": 14 }
      }
    },
    "SignalRuleSetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "rulesetId", "overlay", "settings"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "rulesetId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "overlay": { "type": "boolean" },
        "settings": { "$ref": "#/$defs/SignalSettings" }
      }
    },
    "SeatEngine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller"],
      "properties": {
        "controller": { "type": "string", "enum": ["human", "ai", "auto-ai"] },
        "bidStyle": { "type": "integer", "enum": [0, 1, 2] },
        "playStyle": { "type": "integer", "enum": [0, 1, 2] },
        "randomness": { "type": "number", "minimum": 0, "maximum": 1 },
        "ddsPlay": { "type": "boolean" },
        "ddsSamples": { "type": "integer", "minimum": 1 },
        "objective": { "type": "string", "enum": ["contract", "tricks"] }
      }
    },
    "Engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dealSource", "ruleset", "playRulesets", "seats", "inference"],
      "properties": {
        "dealSource": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "baseSeed", "index"],
              "properties": {
                "kind": { "const": "seeded" },
                "baseSeed": { "type": "integer" },
                "index": { "type": "integer", "minimum": 0 }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind"],
              "properties": {
                "kind": { "const": "imported-pbn" }
              }
            }
          ]
        },
        "rngSeed": {
          "type": "integer",
          "description": "旧版兼容字段；新记录以 streams 为准。seeded 记录可写 streams.deal；imported-pbn 可省略。"
        },
        "streams": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deal": { "type": "integer" },
            "bidding": { "type": "integer" },
            "play": { "type": "integer" },
            "dds": { "type": "integer" }
          },
          "description": "四条独立随机流的实际种子；seeded 必须四条齐全，imported-pbn 至少 bidding/play/dds。"
        },
        "rulesVersion": {
          "type": "string",
          "const": "wbf-laws-2017",
          "description": "本副使用的 WBF 规则版本；1.1 新记录写 wbf-laws-2017。"
        },
        "ruleset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "systemVersion", "rulesetId", "overlay"],
          "properties": {
            "system": { "type": "string", "minLength": 1 },
            "systemVersion": { "type": "string", "minLength": 1 },
            "rulesetId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
            "overlay": { "type": "boolean" }
          }
        },
        "playRulesets": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lead", "signal"],
          "properties": {
            "lead": { "$ref": "#/$defs/RuleSetRef" },
            "signal": { "$ref": "#/$defs/SignalRuleSetRef" }
          }
        },
        "seats": {
          "type": "object",
          "additionalProperties": false,
          "required": ["N", "E", "S", "W"],
          "properties": {
            "N": { "$ref": "#/$defs/SeatEngine" },
            "E": { "$ref": "#/$defs/SeatEngine" },
            "S": { "$ref": "#/$defs/SeatEngine" },
            "W": { "$ref": "#/$defs/SeatEngine" }
          }
        },
        "inference": {
          "type": "object",
          "additionalProperties": false,
          "required": ["auctionConstraints", "leadInference"],
          "properties": {
            "auctionConstraints": { "type": "boolean" },
            "leadInference": { "type": "boolean" }
          }
        },
        "dds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "workerTimeoutMs": { "type": "integer", "minimum": 1 },
            "samples": { "type": "integer", "minimum": 1 },
            "fallback": { "type": "string", "minLength": 1 }
          },
          "description": "开局时冻结的 DDS 全局配置；座位级 ddsPlay/ddsSamples 另见 seats。"
        },
        "engineVersion": { "type": "string", "minLength": 1 },
        "snapshotAt": { "type": "string", "format": "date-time" },
        "rngMode": {
          "type": "string",
          "enum": ["streams", "legacy-shared"],
          "description": "streams=四条独立随机流；legacy-shared=旧版共享 rng，仅用于旧记录回放。"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "dealSource": {
                "properties": { "kind": { "const": "seeded" } },
                "required": ["kind"]
              }
            },
            "required": ["dealSource"]
          },
          "then": {
            "required": ["streams"],
            "properties": {
              "streams": { "required": ["deal", "bidding", "play", "dds"] }
            }
          }
        },
        {
          "if": {
            "properties": {
              "dealSource": {
                "properties": { "kind": { "const": "imported-pbn" } },
                "required": ["kind"]
              }
            },
            "required": ["dealSource"]
          },
          "then": {
            "required": ["streams"],
            "properties": {
              "streams": { "required": ["bidding", "play", "dds"] }
            }
          }
        }
      ]
    }
  }
}
