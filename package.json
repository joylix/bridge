{
  "name": "bridge-mvp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "桥牌游戏 MVP：人机对战 + 可配置规则引擎（精确制叫牌）",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:phase0": "node scripts/checkPhase0.mjs",
    "server:dev": "tsx watch src/server/index.ts",
    "server:start": "tsx src/server/index.ts",
    "db:migrate": "tsx scripts/dbMigrate.ts",
    "brules:check": "vite-node scripts/brules.ts",
    "brules:migrate": "vite-node scripts/brulesMigrate.ts",
    "benchmark": "vite-node scripts/benchmark.ts",
    "bidding-eval": "vite-node scripts/biddingEval.ts"
  },
  "dependencies": {
    "bridge-dds": "^1.4.0",
    "drizzle-orm": "^0.45.4",
    "element-plus": "^2.8.0",
    "fastify": "^5.12.7",
    "js-yaml": "^4.1.0",
    "pg": "^8.23.1",
    "pinia": "^2.2.0",
    "vue": "^3.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/emscripten": "^1.41.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.6",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^15.11.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.1.0",
    "vue-tsc": "^2.1.0"
  }
}
